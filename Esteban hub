-- MAIN UPDATE
--==================================================

local frames = 0
local last = os.clock()
local shakeTime = 0

RunService.RenderStepped:Connect(function(dt)

    Camera = workspace.CurrentCamera or Camera

    -- RGB

    Hue = (Hue+dt*Config.RGBSpeed)%1
    local RGBColor = Color3.fromHSV(Hue,1,1)

    if Config.RGB then
        Border.Color = RGBColor
        Title.TextColor3 = RGBColor
        Subtitle.TextColor3 = RGBColor
    else
        Border.Color = Purple
        Title.TextColor3 = White
        Subtitle.TextColor3 = Purple
    end

    if SmokeEmitter and SmokeEmitter.Parent then
        SmokeEmitter.Color = ColorSequence.new(RGBColor)
    end

    -- AIM ASSIST

    if Config.AimAssist then

        local target = GetTarget()

        if target and target.Parent then

            local position = target.Position

            if Config.AimPrediction then
                position += target.AssemblyLinearVelocity*0.12
            end

            local strengths = {
                Suave = 0.04,
                Medio = 0.10,
                Fuerte = 0.25,
                Extremo = 1
            }

            local amount = strengths[Config.AimStrength] or 0.10

            if Config.AimStrength ~= "Extremo" then
                amount = math.clamp(
                    amount*(Config.AimSmoothness/0.10),
                    0.01,
                    0.85
                )
            end

            local desired = CFrame.lookAt(
                Camera.CFrame.Position,
                position
            )

            Camera.CFrame = Camera.CFrame:Lerp(desired,amount)
        end
    end

    -- PLAYER VISUALS + TRACERS

    for plr,data in pairs(ESPObjects) do

        local character = plr.Character

        local root = character and
            character:FindFirstChild("HumanoidRootPart")

        local humanoid = character and
            character:FindFirstChildOfClass("Humanoid")

        if root and humanoid and humanoid.Health > 0 then

            local distance = math.huge

            if Player.Character then

                local myRoot =
                    Player.Character:FindFirstChild("HumanoidRootPart")

                if myRoot then
                    distance = (myRoot.Position-root.Position).Magnitude
                end
            end

            local inRange = distance <= Config.ESPDistance
            local color = Config.RGB and RGBColor or Purple

            data.Highlight.Enabled = Config.Chams and inRange
            data.Highlight.FillColor = color
            data.Highlight.OutlineColor = color

            data.Name.Visible = Config.ESPName
            data.Name.Text = plr.DisplayName
            data.Name.TextColor3 = color

            data.Health.Visible = Config.ESPHealth
            data.Health.Text =
                "HP: "..math.floor(humanoid.Health)
                .."/"..math.floor(humanoid.MaxHealth)

            data.Weapon.Visible = Config.ESPWeapons

            local equippedTool =
                character:FindFirstChildOfClass("Tool")

            data.Weapon.Text =
                equippedTool and equippedTool.Name or "Sin arma"

            local _,visible =
                Camera:WorldToViewportPoint(root.Position)

            data.Billboard.Enabled =
                visible and inRange and (
                    Config.ESPName
                    or Config.ESPHealth
                    or Config.ESPWeapons
                )

            -- TRACERS

            data.TracerPart.CFrame = Camera.CFrame

            if data.EndAttachment.Parent ~= root then
                data.EndAttachment.Parent = root
            end

            data.Tracer.Enabled =
                Config.Tracers and inRange and visible

            data.Tracer.Color = ColorSequence.new(color)

        else

            data.Billboard.Enabled = false
            data.Highlight.Enabled = false
            data.Tracer.Enabled = false
        end
    end

    -- CAMERA SHAKE

    if Config.CameraShake then

        shakeTime += dt*15

        local amount = Config.ShakeIntensity*0.002

        local offset = Vector3.new(
            math.sin(shakeTime)*amount,
            math.cos(shakeTime*1.3)*amount,
            0
        )

        Camera.CFrame = Camera.CFrame*CFrame.new(offset)
    end

    -- FPS / PING

    frames += 1

    if os.clock()-last >= 1 then

        local fps = frames
        frames = 0
        last = os.clock()

        local ping = 0

        pcall(function()
            ping = Stats.Network.ServerStatsItem[
                "Data Ping"
            ]:GetValue()
        end)

        StatsLabel.Text =
            "FPS: "..fps..
            "\nPING: "..math.floor(ping).." ms"
    end
end)

