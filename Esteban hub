local function SetParticles(disabled)

    if disabled then
        table.clear(ParticleStates)

        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Beam") then
                ParticleStates[obj] = obj.Enabled
                obj.Enabled = false
            end
        end
    else
        for obj,state in pairs(ParticleStates) do
            if obj.Parent then
                obj.Enabled = state
            end
        end

        table.clear(ParticleStates)
    end
end

Button("Disable Particles",function(v)
    Config.DisableParticles = v
    SetParticles(v)
end)

