--==================================================
-- TARGET SELECTION
--==================================================

local function GetTarget()

    local character = Player.Character
    if not character then return nil end

    local myRoot = character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local bestPart
    local bestScreenDistance = Config.AimFOV
    local bestWorldDistance = math.huge

    for _,plr in ipairs(Players:GetPlayers()) do

        if plr ~= Player then

            local targetCharacter = plr.Character

            if targetCharacter then

                local humanoid =
                    targetCharacter:FindFirstChildOfClass("Humanoid")

                local root =
                    targetCharacter:FindFirstChild("HumanoidRootPart")

                if humanoid and humanoid.Health > 0 and root then

                    local distance =
                        (myRoot.Position-root.Position).Magnitude

                    -- RANGE: maximum configurable distance.
                    -- Targets closer than 80 studs are also valid.

                    if distance <= Config.AimRange then

                        local part

                        if Config.AimTarget == "Head" then
                            part = targetCharacter:FindFirstChild("Head")
                        else
                            part =
                                targetCharacter:FindFirstChild("UpperTorso")
                                or targetCharacter:FindFirstChild("Torso")
                                or root
                        end

                        if part then

                            local screen,visible =
                                Camera:WorldToViewportPoint(part.Position)

                            if visible then

                                if UIS.TouchEnabled then

                                    -- MOBILE: no FOV restriction.
                                    -- Select nearest valid target.

                                    if distance < bestWorldDistance then
                                        bestWorldDistance = distance
                                        bestPart = part
                                    end

                                else

                                    -- PC: use configurable screen FOV.

                                    local center = Camera.ViewportSize/2

                                    local screenDistance =
                                        (Vector2.new(screen.X,screen.Y)-center).Magnitude

                                    if screenDistance < bestScreenDistance then
                                        bestScreenDistance = screenDistance
                                        bestPart = part
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return bestPart
end

